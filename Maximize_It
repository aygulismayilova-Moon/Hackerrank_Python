# Enter your code here. Read input from STDIN. Print output to STDOUT
import itertools
if __name__=="__main__":
    n,m=list(map(int,input().split()))
    
    
    k=[list(map(int,input().split()))[1:] for i in range(n)]

    #b=a%n[1]
    z=list(itertools.product(*k))
    #print(z)
    c=0
    for i in z:
        g=0
        #print(i)
        for n in i:
            #print(n)
            g+=n**2
        if c<g%m:
            c=g%m 
    print(c)
