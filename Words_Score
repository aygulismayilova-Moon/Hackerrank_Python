def is_vowel(letter):
    return letter in ['a', 'e', 'i', 'o', 'u', 'y']

def score_words(words):
    score = 0
    cn=0
    for word in words:
        num_vowels = 0
        for letter in word:
            cn+=1
            #print(cn)
            if is_vowel(letter):
                num_vowels += 1
                #print(len(word))
                #print(cn)
            if num_vowels % 2 == 0 and cn==len(word):
                score += 2
                    #print(score)
                cn=0
            elif cn==len(word) and num_vowels%2!=0:
                score+=1
                    #print(score)
                cn=0 
            
    return score

