from collections import namedtuple
if __name__=='__main__':
    n=int(input())
    z=[]
    l=0
    for i in range(n+1):
        student_=input().split()
        z.append(student_)
    #print(z)
    for i in range(n):
        Students=namedtuple('Students',z[0])
        if i <n:
            abc=Students(z[i+1][0],z[i+1][1],z[i+1][2],z[i+1][3])
            l+=int(abc.MARKS)
        if n!=0:
            avg=l/n
    print(avg)
