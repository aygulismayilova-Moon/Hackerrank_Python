# Enter your code here. Read input from STDIN. Print output to STDOUT
from collections import deque
if __name__=='__main__':
    n=int(input())
    d=deque()
    
    for i in range(n):
        s=input().split()
        if s[0]=='append':
            d.append(int(s[1]))
        elif s[0]=='appendleft':
            d.appendleft(int(s[1]))
        elif s[0]=='pop':
            d.pop()
        elif s[0]=='popleft':
            d.popleft()
    print(" ".join(map(str,d)))
